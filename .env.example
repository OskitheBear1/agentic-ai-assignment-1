# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Nothing in this file is a real secret — these are placeholders only.
# ---------------------------------------------------------------------------

# ===========================================================================
# FRONTEND (frontend/.env.local) — PUBLIC. These are compiled into the browser
# bundle and are safe to expose. Vite requires the VITE_ prefix; these are the
# non-Next.js equivalents of NEXT_PUBLIC_NEON_AUTH_URL / NEXT_PUBLIC_NEON_DATA_API_URL.
# ===========================================================================

# Neon Managed Better Auth endpoint (HTTPS). Browser signs in/out against this.
VITE_NEON_AUTH_URL=https://ep-example-123456.us-east-2.aws.neon.tech/neondb/auth

# Neon Data API endpoint (HTTPS). Used by the RLS privacy test to query the
# database directly with a user's token and prove Row Level Security holds.
VITE_NEON_DATA_API_URL=https://ep-example-123456.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

# Base URL of our own Node backend.
VITE_API_URL=http://localhost:3000

# ===========================================================================
# BACKEND (backend/.env.local) — SERVER-ONLY. These are never bundled, never
# sent to the browser, and never committed.
# ===========================================================================

# Same Neon auth endpoint. The backend uses it to fetch the JWKS
# (<NEON_AUTH_URL>/.well-known/jwks.json) and verify incoming JWT signatures.
NEON_AUTH_URL=https://ep-example-123456.us-east-2.aws.neon.tech/neondb/auth

# Same Neon Data API endpoint. The backend forwards the signed-in user's JWT here.
NEON_DATA_API_URL=https://ep-example-123456.apirest.us-east-2.aws.neon.tech/neondb/rest/v1

# Allowed CORS origin(s), comma-separated. Locks the API to our frontend.
FRONTEND_URL=http://localhost:5173

# Port for local dev.
PORT=3000

# SECRET. Postgres connection string. Used ONLY by db/migrate.ts to create the
# schema and RLS policies. It is never read at request time and never reaches
# the frontend. Do not add this to the frontend Vercel project.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ===========================================================================
# TEST ACCOUNTS (backend/.env.local) — used by the two-user RLS privacy test.
# ===========================================================================
TEST_USER_A_EMAIL=user-a@example.com
TEST_USER_A_PASSWORD=replace-with-a-strong-password
TEST_USER_B_EMAIL=user-b@example.com
TEST_USER_B_PASSWORD=replace-with-a-strong-password

# ===========================================================================
# NOT USED BY THIS IMPLEMENTATION
# ---------------------------------------------------------------------------
# NEON_AUTH_BASE_URL and NEON_AUTH_COOKIE_SECRET are only needed when your own
# server hosts the Better Auth request handler. This app does not: the browser
# talks to Neon-hosted Managed Better Auth directly, and our backend only
# verifies the resulting JWT. If you did use them, they would be server-only.
# ===========================================================================
